# Environment variables untuk production di Render
# Salin file ini dan isi nilainya di dashboard Render

# ============================================
# DATABASE (Aiven MySQL)
# ============================================
DB_HOST=           # Host dari Aiven (contoh: mysql-xxxx.aivencloud.com)
DB_PORT=           # Port dari Aiven (biasanya 3306 atau port custom)
DB_NAME=           # Nama database kamu di Aiven
DB_USER=           # Username dari Aiven
DB_PASSWORD=       # Password dari Aiven

# ============================================
# JWT
# ============================================
JWT_SECRET=        # Ganti dengan string acak yang panjang dan aman
JWT_EXPIRES_IN=7d

# ============================================
# SERVER
# ============================================
PORT=10000
NODE_ENV=production

# ============================================
# FRONTEND URL (Vercel) - untuk CORS
# ============================================
FRONTEND_URL=      # URL frontend Vercel kamu (contoh: https://hmsi-rtk.vercel.app)
